{
    "elements": [
        {
            "type": "List",
            "name": "Calendars",
            "caption": "Calendars",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Calendar instance",
                    "name": "InstanceID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectInstance",
                        "validModules": [
                            "{227B63E4-4223-316B-76E9-FD3849689562}"
                        ]
                    }
                },
                {
                    "caption": "Enabled",
                    "name": "Enabled",
                    "width": "100px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
            ]
        },
        {
            "type": "Select",
            "name": "DefaultView",
            "caption": "Default view",
            "options": [
                {
                    "caption": "Agenda",
                    "value": 0
                },
                {
                    "caption": "3 Days",
                    "value": 3
                },
                {
                    "caption": "Week",
                    "value": 1
                },
                {
                    "caption": "Month",
                    "value": 2
                }
            ]
        },
        {
            "type": "Select",
            "name": "TileWeekOrientation",
            "caption": "Tile week orientation",
            "options": [
                {
                    "caption": "Horizontal",
                    "value": 0
                },
                {
                    "caption": "Vertical",
                    "value": 1
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "PastDays",
                    "caption": "Past days",
                    "minimum": 0,
                    "maximum": 1095
                },
                {
                    "type": "NumberSpinner",
                    "name": "FutureDays",
                    "caption": "Future days",
                    "minimum": 1,
                    "maximum": 1095
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxEvents",
                    "caption": "Maximum events",
                    "minimum": 1,
                    "maximum": 1000
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "ShowWeekends",
                    "caption": "Show weekends"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowCalendarName",
                    "caption": "Show calendar name"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowLocation",
                    "caption": "Show location"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowDescription",
                    "caption": "Show description"
                }
            ]
        },
        {
            "type": "PopupButton",
            "caption": "Display options",
            "popup": {
                "caption": "Display options",
                "items": [
                    {
                        "type": "RowLayout",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Display",
                                "width": "220px"
                            },
                            {
                                "type": "Label",
                                "caption": "Agenda",
                                "width": "95px"
                            },
                            {
                                "type": "Label",
                                "caption": "3 Days",
                                "width": "95px"
                            },
                            {
                                "type": "Label",
                                "caption": "Week",
                                "width": "95px"
                            },
                            {
                                "type": "Label",
                                "caption": "Month",
                                "width": "95px"
                            }
                        ]
                    },
                    {
                        "type": "RowLayout",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Event count",
                                "width": "220px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowAgendaEventCount",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowThreeDaysEventCount",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowWeekEventCount",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "Label",
                                "caption": "—",
                                "width": "95px"
                            }
                        ]
                    },
                    {
                        "type": "RowLayout",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Calendar week",
                                "width": "220px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowAgendaCalendarWeek",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowThreeDaysCalendarWeek",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowWeekCalendarWeek",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowMonthCalendarWeek",
                                "caption": "",
                                "width": "95px"
                            }
                        ]
                    },
                    {
                        "type": "RowLayout",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Day of year",
                                "width": "220px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowAgendaDayOfYear",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowThreeDaysDayOfYear",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowWeekDayOfYear",
                                "caption": "",
                                "width": "95px"
                            },
                            {
                                "type": "CheckBox",
                                "name": "ShowMonthDayOfYear",
                                "caption": "",
                                "width": "95px"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "type": "ExpansionPanel",
            "caption": "IPSView",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Configure optional IPSView HTML output."
                },
                {
                    "type": "Label",
                    "caption": "Configure the shared IPSView style used by the standalone HTML page."
                },
                {
                    "type": "Select",
                    "name": "IPSViewWeekOrientation",
                    "caption": "IPSView week orientation",
                    "options": [
                        {
                            "caption": "Horizontal",
                            "value": 0
                        },
                        {
                            "caption": "Vertical",
                            "value": 1
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "IPSViewColorBarWidth",
                    "caption": "IPSView color bar width",
                    "minimum": 2,
                    "maximum": 16,
                    "suffix": " px"
                },
                {
                    "type": "Label",
                    "caption": "In IPSView, use an HTML-Box with the client browser renderer so JavaScript is available."
                },
                {
                    "type": "Button",
                    "caption": "Regenerate IPSView HTML",
                    "onClick": "IPS_RequestAction($id, 'FormRegenerateIPSViewHTML', '');"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Synchronize calendars",
            "onClick": "IPS_RequestAction($id, 'FormSynchronizeCalendars', '');"
        },
        {
            "type": "Button",
            "caption": "Restore all calendar instances",
            "onClick": "IPS_RequestAction($id, 'FormRestoreCalendars', '');"
        },
        {
            "type": "PopupAlert",
            "name": "SynchronizationSuccessPopup",
            "visible": false,
            "popup": {
                "items": [
                    {
                        "type": "Label",
                        "caption": "Synchronization successful."
                    }
                ]
            }
        },
        {
            "type": "PopupAlert",
            "name": "SynchronizationFailurePopup",
            "visible": false,
            "popup": {
                "items": [
                    {
                        "type": "Label",
                        "caption": "Synchronization failed. Please check the instance status for details."
                    }
                ]
            }
        },
        {
            "type": "PopupAlert",
            "name": "CalendarSelectionRestoredPopup",
            "visible": false,
            "popup": {
                "items": [
                    {
                        "type": "Label",
                        "caption": "Calendar selection restored."
                    }
                ]
            }
        },
        {
            "type": "PopupAlert",
            "name": "NoCalendarInstancesPopup",
            "visible": false,
            "popup": {
                "items": [
                    {
                        "type": "Label",
                        "caption": "No calendar instances found."
                    }
                ]
            }
        },
        {
            "type": "PopupAlert",
            "name": "IPSViewRegenerationSuccessPopup",
            "visible": false,
            "popup": {
                "items": [
                    {
                        "type": "Label",
                        "caption": "IPSView HTML regenerated."
                    }
                ]
            }
        },
        {
            "type": "PopupAlert",
            "name": "IPSViewRegenerationFailurePopup",
            "visible": false,
            "popup": {
                "items": [
                    {
                        "type": "Label",
                        "caption": "IPSView HTML could not be regenerated. Enable IPSView output and apply the instance configuration first."
                    }
                ]
            }
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "inactive",
            "caption": "No calendars selected"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Invalid configuration"
        }
    ]
}
