{
    "actions": [
        {
            "type": "Label",
            "caption": "OpenCalendar can be configured step by step with the setup assistant."
        },
        {
            "type": "Label",
            "caption": "The setup assistant handles the technical OpenCalendar structure for you and guides you through all required steps."
        },
        {
            "type": "Label",
            "caption": "1. Select the calendar provider (Google, Microsoft 365 / Outlook.com, Apple iCloud, CalDAV or ICS / Webcal)."
        },
        {
            "type": "Label",
            "caption": "2. Create a new calendar account or use an existing one. New accounts remain inactive until setup is completed successfully."
        },
        {
            "type": "Label",
            "caption": "3. Configure and verify the provider connection. Google and Microsoft use the native Symcon OAuth flow."
        },
        {
            "type": "Label",
            "caption": "4. OpenCalendar discovers the calendars available in the account and lets you choose which calendars should be used."
        },
        {
            "type": "Label",
            "caption": "5. The selected calendars are created as calendar instances and connected automatically to the calendar account. Existing matching calendar instances are reused."
        },
        {
            "type": "Label",
            "caption": "6. Choose or create a Calendar View. OpenCalendar assigns the selected calendar instances to it automatically."
        },
        {
            "type": "Label",
            "caption": "7. OpenCalendar performs a final synchronization and technical check and then shows a result overview."
        },
        {
            "type": "Label",
            "caption": "For easier identification, newly created calendar instances receive the provider as a name prefix, for example O365 - Family, Apple - Private, Google - Work, CalDAV - Family or ICS - Holidays."
        },
        {
            "type": "Label",
            "caption": "Existing calendar instances that are reused keep their current names."
        },
        {
            "type": "Label",
            "caption": "Optional: You can also create a Calendar Configurator. It can later discover and add further calendars from the same account."
        },
        {
            "type": "Label",
            "caption": "The setup assistant can be started again later to add further calendar accounts or calendars."
        },
        {
            "type": "PopupButton",
            "name": "SetupWizard",
            "caption": "Start OpenCalendar setup assistant",
            "width": "400px",
            "popup": {
                "caption": "OpenCalendar setup",
                "closeCaption": "Cancel",
                "items": [
                    {
                        "type": "Label",
                        "caption": "This fallback content is not shown while wizard pages are available."
                    }
                ],
                "pages": [
                    {
                        "name": "welcome",
                        "caption": "Welcome to OpenCalendar",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "This assistant will guide you through the initial OpenCalendar setup."
                            },
                            {
                                "type": "Label",
                                "caption": "The assistant can use an existing calendar account or create a new one."
                            }
                        ],
                        "nextPage": "provider"
                    },
                    {
                        "name": "provider",
                        "caption": "Choose calendar provider",
                        "items": [
                            {
                                "type": "RadioButtonGroup",
                                "name": "Provider",
                                "caption": "Calendar provider",
                                "value": "",
                                "options": [
                                    {
                                        "caption": "Please select a provider",
                                        "value": ""
                                    },
                                    {
                                        "caption": "Google Calendar",
                                        "value": "google"
                                    },
                                    {
                                        "caption": "Microsoft 365 / Outlook.com",
                                        "value": "microsoft"
                                    },
                                    {
                                        "caption": "Apple iCloud",
                                        "value": "apple"
                                    },
                                    {
                                        "caption": "CalDAV",
                                        "value": "caldav"
                                    },
                                    {
                                        "caption": "ICS / Webcal",
                                        "value": "ics"
                                    }
                                ]
                            },
                            {
                                "type": "CheckBox",
                                "name": "CreateConfigurator",
                                "caption": "Create Calendar Configurator as well",
                                "value": false
                            },
                            {
                                "type": "Label",
                                "caption": "The Calendar Configurator is optional. It can later rediscover the calendars of this account and lets you add further calendar instances without running the setup assistant again."
                            },
                            {
                                "type": "Label",
                                "caption": "If a Calendar Configurator is already connected to the selected calendar account, OpenCalendar reuses it and does not create a duplicate."
                            }
                        ],
                        "validate": "return $Provider === '' ? 'Please select a calendar provider.' : '';",
                        "onConfirm": "IPS_RequestAction($id, 'WizardProvider', json_encode(['provider' => $Provider, 'createConfigurator' => $CreateConfigurator], JSON_THROW_ON_ERROR));",
                        "onUndo": "IPS_RequestAction($id, 'WizardProviderUndo', '');",
                        "nextPage": "account"
                    },
                    {
                        "name": "account",
                        "caption": "Choose calendar account",
                        "items": [
                            {
                                "type": "RadioButtonGroup",
                                "name": "AccountMode",
                                "caption": "Calendar account",
                                "value": "new",
                                "options": [
                                    {
                                        "caption": "Create a new calendar account",
                                        "value": "new"
                                    },
                                    {
                                        "caption": "Use an existing calendar account",
                                        "value": "existing"
                                    }
                                ]
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "AccountName",
                                "caption": "Name for the new calendar account",
                                "value": ""
                            },
                            {
                                "type": "Select",
                                "name": "ExistingAccountID",
                                "caption": "Existing calendar account",
                                "value": 0,
                                "options": [
                                    {
                                        "caption": "Please select an existing calendar account.",
                                        "value": 0
                                    }
                                ]
                            },
                            {
                                "type": "Label",
                                "caption": "For a new account, enter a name. For an existing account, select an account that uses the chosen provider."
                            },
                            {
                                "type": "Label",
                                "caption": "A new calendar account remains disabled while setup is incomplete. OpenCalendar activates it automatically after a successful connection test and completed setup."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardAccountSelection($id, $AccountMode, $ExistingAccountID, $AccountName);",
                        "onConfirm": "IPS_RequestAction($id, 'WizardPrepareAccount', json_encode(['mode' => $AccountMode, 'existingAccountID' => $ExistingAccountID, 'accountName' => $AccountName], JSON_THROW_ON_ERROR));",
                        "onUndo": "IPS_RequestAction($id, 'WizardAccountSelectionUndo', '');",
                        "nextPage": "return IPSKALDISCOVERY_GetWizardProviderPage($id);"
                    },
                    {
                        "name": "apple",
                        "caption": "Configure Apple iCloud",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Enter the Apple Account email address and an app-specific password."
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "AppleUsername",
                                "caption": "Apple Account email address"
                            },
                            {
                                "type": "PasswordTextBox",
                                "name": "ApplePassword",
                                "caption": "App-specific password"
                            },
                            {
                                "type": "Label",
                                "caption": "For an existing account, empty fields keep the currently stored values."
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardAppleConfiguration($id, $AppleUsername, $ApplePassword);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "caldav",
                        "caption": "Configure CalDAV",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "ValidationTextBox",
                                "name": "CalDAVServerURL",
                                "caption": "CalDAV server URL",
                                "validate": "^$|^https?://.+"
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "CalDAVUsername",
                                "caption": "Username"
                            },
                            {
                                "type": "PasswordTextBox",
                                "name": "CalDAVPassword",
                                "caption": "Password"
                            },
                            {
                                "type": "Label",
                                "caption": "For an existing account, empty fields keep the currently stored values."
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardCalDAVConfiguration($id, $CalDAVServerURL, $CalDAVUsername, $CalDAVPassword);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "google",
                        "caption": "Connect Google Calendar",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Connect the Google account through the native Symcon OAuth flow."
                            },
                            {
                                "type": "Label",
                                "caption": "After the authorization window reports success, return here and click Next."
                            },
                            {
                                "type": "Button",
                                "caption": "Connect Google account",
                                "link": true,
                                "onClick": "echo IPSKALDISCOVERY_BeginWizardOAuth($id);"
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardOAuthConnection($id);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "microsoft",
                        "caption": "Connect Microsoft 365",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Connect the Microsoft 365 or Outlook.com account through the native Symcon OAuth flow."
                            },
                            {
                                "type": "Label",
                                "caption": "After the authorization window reports success, return here and click Next."
                            },
                            {
                                "type": "Button",
                                "caption": "Connect Microsoft account",
                                "link": true,
                                "onClick": "echo IPSKALDISCOVERY_BeginWizardOAuth($id);"
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardOAuthConnection($id);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "ics",
                        "caption": "Configure ICS / Webcal",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "ValidationTextBox",
                                "name": "ICSURL",
                                "caption": "iCalendar URL",
                                "validate": "^$|^(https?|webcal)://.+"
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "ICSCalendarName",
                                "caption": "Calendar name"
                            },
                            {
                                "type": "RadioButtonGroup",
                                "name": "ICSAuthenticationMode",
                                "caption": "Authentication",
                                "value": 1,
                                "options": [
                                    {
                                        "caption": "URL / access key",
                                        "value": 1
                                    },
                                    {
                                        "caption": "Username / password",
                                        "value": 2
                                    }
                                ]
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "ICSUsername",
                                "caption": "Username"
                            },
                            {
                                "type": "PasswordTextBox",
                                "name": "ICSPassword",
                                "caption": "Password"
                            },
                            {
                                "type": "Label",
                                "caption": "Username and password are only used when Username / password is selected."
                            },
                            {
                                "type": "Label",
                                "caption": "For an existing account, leave the URL empty to test the existing iCalendar configuration unchanged."
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardICalendarConfiguration($id, $ICSURL, $ICSCalendarName, $ICSAuthenticationMode, $ICSUsername, $ICSPassword);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "calendars",
                        "caption": "Choose calendars",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Select the calendars that OpenCalendar should prepare for this setup."
                            },
                            {
                                "type": "List",
                                "name": "WizardCalendars",
                                "caption": "Available calendars",
                                "rowCount": 8,
                                "add": false,
                                "delete": false,
                                "changeOrder": false,
                                "loadValuesFromConfiguration": false,
                                "columns": [
                                    {
                                        "caption": "Use",
                                        "name": "selected",
                                        "width": "70px",
                                        "align": "center",
                                        "save": true,
                                        "edit": {
                                            "type": "CheckBox"
                                        }
                                    },
                                    {
                                        "caption": "Calendar",
                                        "name": "name",
                                        "width": "auto"
                                    },
                                    {
                                        "caption": "Access",
                                        "name": "access",
                                        "width": "140px"
                                    },
                                    {
                                        "caption": "Default",
                                        "name": "primary",
                                        "width": "90px",
                                        "align": "center"
                                    },
                                    {
                                        "caption": "Calendar ID",
                                        "name": "calendarId",
                                        "width": "1px",
                                        "visible": false,
                                        "save": true
                                    }
                                ],
                                "values": [],
                                "onEdit": "IPS_RequestAction($id, 'WizardCalendarSelectionChanged', json_encode(['calendarId' => $WizardCalendars['calendarId'], 'selected' => $WizardCalendars['selected']], JSON_THROW_ON_ERROR));"
                            },
                            {
                                "type": "Label",
                                "caption": "Select at least one calendar. A primary calendar, or the only available calendar, is preselected automatically."
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardCalendarSelection($id);",
                        "onConfirm": "IPS_RequestAction($id, 'WizardSelectCalendars', '');",
                        "onUndo": "IPS_RequestAction($id, 'WizardCalendarSelectionUndo', '');",
                        "nextPage": "view"
                    },
                    {
                        "name": "view",
                        "caption": "Choose calendar view",
                        "items": [
                            {
                                "type": "RadioButtonGroup",
                                "name": "ViewMode",
                                "caption": "Calendar view",
                                "value": "new",
                                "options": [
                                    {
                                        "caption": "Create a new calendar view",
                                        "value": "new"
                                    },
                                    {
                                        "caption": "Use an existing calendar view",
                                        "value": "existing"
                                    }
                                ]
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "ViewName",
                                "caption": "Name for the new calendar view",
                                "value": "OpenCalendar"
                            },
                            {
                                "type": "Select",
                                "name": "ExistingViewID",
                                "caption": "Existing calendar view",
                                "value": 0,
                                "options": [
                                    {
                                        "caption": "Please select an existing calendar view.",
                                        "value": 0
                                    }
                                ]
                            },
                            {
                                "type": "Label",
                                "caption": "For a new view, enter a name. For an existing view, select the view that should receive the selected calendars."
                            },
                            {
                                "type": "Label",
                                "caption": "Selected calendar instances are enabled in the view. Existing calendar assignments in a reused view are preserved."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardCalendarViewSelection($id, $ViewMode, $ExistingViewID, $ViewName);",
                        "onConfirm": "IPS_RequestAction($id, 'WizardSelectCalendarView', json_encode(['mode' => $ViewMode, 'existingViewID' => $ExistingViewID, 'viewName' => $ViewName], JSON_THROW_ON_ERROR));",
                        "onUndo": "IPS_RequestAction($id, 'WizardCalendarViewSelectionUndo', '');",
                        "nextPage": "summary",
                        "closeCaption": "Set up later"
                    },
                    {
                        "name": "summary",
                        "caption": "Review OpenCalendar setup",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "The calendar account connection was verified successfully."
                            },
                            {
                                "type": "Label",
                                "caption": "With Next, OpenCalendar creates the selected calendars as calendar instances. Existing matching calendar instances are reused."
                            },
                            {
                                "type": "Label",
                                "caption": "New calendar instances are named with the provider prefix, for example O365 - Family or Apple - Private."
                            },
                            {
                                "type": "Label",
                                "caption": "If selected, OpenCalendar also creates a Calendar Configurator for this account. An existing matching configurator is reused."
                            },
                            {
                                "type": "Label",
                                "caption": "With Next, OpenCalendar creates a new Calendar View or uses the selected existing view and assigns the selected calendar instances to it. Existing assignments are preserved."
                            },
                            {
                                "type": "Label",
                                "caption": "OpenCalendar then synchronizes the account and selected calendars, initializes the Calendar View and shows the result on the final page."
                            },
                            {
                                "type": "Label",
                                "caption": "A newly created calendar account is activated. Existing accounts keep their current activation state."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardConfirmation($id);",
                        "onConfirm": "IPS_RequestAction($id, 'WizardFinishAccount', '');",
                        "nextPage": "result"
                    },
                    {
                        "name": "result",
                        "caption": "OpenCalendar setup completed",
                        "closeCaption": "Finish",
                        "items": [
                            {
                                "type": "Label",
                                "name": "ResultStatus",
                                "caption": "OpenCalendar setup result"
                            },
                            {
                                "type": "Label",
                                "name": "ResultAccount",
                                "caption": "Calendar account result"
                            },
                            {
                                "type": "Label",
                                "name": "ResultConfigurator",
                                "caption": "Calendar Configurator result"
                            },
                            {
                                "type": "Label",
                                "name": "ResultCalendars",
                                "caption": "Calendar instance result"
                            },
                            {
                                "type": "Label",
                                "name": "ResultSynchronization",
                                "caption": "Synchronization result"
                            },
                            {
                                "type": "Label",
                                "name": "ResultView",
                                "caption": "Calendar View result"
                            },
                            {
                                "type": "Label",
                                "caption": "The setup assistant can be closed now. You can start it again later to add more calendar accounts or calendars."
                            }
                        ],
                        "onConfirm": "IPS_RequestAction($id, 'WizardComplete', '');"
                    }
                ]
            }
        }
    ]
}
