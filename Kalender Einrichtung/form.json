{
    "actions": [
        {
            "type": "Label",
            "caption": "OpenCalendar can be configured step by step with the setup assistant."
        },
        {
            "type": "PopupButton",
            "name": "SetupWizard",
            "caption": "Start OpenCalendar setup",
            "width": "300px",
            "popup": {
                "caption": "OpenCalendar setup",
                "closeCaption": "Cancel",
                "items": [
                    {
                        "type": "Label",
                        "caption": "This fallback content is not shown while wizard pages are available."
                    }
                ],
                "pages": [
                    {
                        "name": "welcome",
                        "caption": "Welcome to OpenCalendar",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "This assistant will guide you through the initial OpenCalendar setup."
                            },
                            {
                                "type": "Label",
                                "caption": "The assistant can use an existing calendar account or create a new one."
                            }
                        ],
                        "nextPage": "provider"
                    },
                    {
                        "name": "provider",
                        "caption": "Choose calendar provider",
                        "items": [
                            {
                                "type": "RadioButtonGroup",
                                "name": "Provider",
                                "caption": "Calendar provider",
                                "value": "",
                                "options": [
                                    {
                                        "caption": "Please select a provider",
                                        "value": ""
                                    },
                                    {
                                        "caption": "Google Calendar",
                                        "value": "google"
                                    },
                                    {
                                        "caption": "Microsoft 365 / Outlook.com",
                                        "value": "microsoft"
                                    },
                                    {
                                        "caption": "Apple iCloud",
                                        "value": "apple"
                                    },
                                    {
                                        "caption": "CalDAV",
                                        "value": "caldav"
                                    },
                                    {
                                        "caption": "ICS / Webcal",
                                        "value": "ics"
                                    }
                                ]
                            }
                        ],
                        "validate": "return $Provider === '' ? 'Please select a calendar provider.' : '';",
                        "onConfirm": "IPS_RequestAction($id, 'WizardProvider', $Provider);",
                        "onUndo": "IPS_RequestAction($id, 'WizardProviderUndo', '');",
                        "nextPage": "account"
                    },
                    {
                        "name": "account",
                        "caption": "Choose calendar account",
                        "items": [
                            {
                                "type": "RadioButtonGroup",
                                "name": "AccountMode",
                                "caption": "Calendar account",
                                "value": "new",
                                "options": [
                                    {
                                        "caption": "Create a new calendar account",
                                        "value": "new"
                                    },
                                    {
                                        "caption": "Use an existing calendar account",
                                        "value": "existing"
                                    }
                                ]
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "AccountName",
                                "caption": "Name for the new calendar account",
                                "value": ""
                            },
                            {
                                "type": "Select",
                                "name": "ExistingAccountID",
                                "caption": "Existing calendar account",
                                "value": 0,
                                "options": [
                                    {
                                        "caption": "Please select an existing calendar account.",
                                        "value": 0
                                    }
                                ]
                            },
                            {
                                "type": "Label",
                                "caption": "For a new account, enter a name. For an existing account, select an account that uses the chosen provider."
                            },
                            {
                                "type": "Label",
                                "caption": "A new calendar account remains disabled while setup is incomplete. OpenCalendar activates it automatically after a successful connection test and completed setup."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardAccountSelection($id, $AccountMode, $ExistingAccountID, $AccountName);",
                        "onConfirm": "IPS_RequestAction($id, 'WizardPrepareAccount', json_encode(['mode' => $AccountMode, 'existingAccountID' => $ExistingAccountID, 'accountName' => $AccountName], JSON_THROW_ON_ERROR));",
                        "onUndo": "IPS_RequestAction($id, 'WizardAccountSelectionUndo', '');",
                        "nextPage": "return IPSKALDISCOVERY_GetWizardProviderPage($id);"
                    },
                    {
                        "name": "apple",
                        "caption": "Configure Apple iCloud",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Enter the Apple Account email address and an app-specific password."
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "AppleUsername",
                                "caption": "Apple Account email address"
                            },
                            {
                                "type": "PasswordTextBox",
                                "name": "ApplePassword",
                                "caption": "App-specific password"
                            },
                            {
                                "type": "Label",
                                "caption": "For an existing account, empty fields keep the currently stored values."
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardAppleConfiguration($id, $AppleUsername, $ApplePassword);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "caldav",
                        "caption": "Configure CalDAV",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "ValidationTextBox",
                                "name": "CalDAVServerURL",
                                "caption": "CalDAV server URL",
                                "validate": "^$|^https?://.+"
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "CalDAVUsername",
                                "caption": "Username"
                            },
                            {
                                "type": "PasswordTextBox",
                                "name": "CalDAVPassword",
                                "caption": "Password"
                            },
                            {
                                "type": "Label",
                                "caption": "For an existing account, empty fields keep the currently stored values."
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardCalDAVConfiguration($id, $CalDAVServerURL, $CalDAVUsername, $CalDAVPassword);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "google",
                        "caption": "Connect Google Calendar",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Connect the Google account through the native Symcon OAuth flow."
                            },
                            {
                                "type": "Label",
                                "caption": "After the authorization window reports success, return here and click Next."
                            },
                            {
                                "type": "Button",
                                "caption": "Connect Google account",
                                "link": true,
                                "onClick": "echo IPSKALDISCOVERY_BeginWizardOAuth($id);"
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardOAuthConnection($id);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "microsoft",
                        "caption": "Connect Microsoft 365",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Connect the Microsoft 365 or Outlook.com account through the native Symcon OAuth flow."
                            },
                            {
                                "type": "Label",
                                "caption": "After the authorization window reports success, return here and click Next."
                            },
                            {
                                "type": "Button",
                                "caption": "Connect Microsoft account",
                                "link": true,
                                "onClick": "echo IPSKALDISCOVERY_BeginWizardOAuth($id);"
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardOAuthConnection($id);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "ics",
                        "caption": "Configure ICS / Webcal",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "ValidationTextBox",
                                "name": "ICSURL",
                                "caption": "iCalendar URL",
                                "validate": "^$|^(https?|webcal)://.+"
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "ICSCalendarName",
                                "caption": "Calendar name"
                            },
                            {
                                "type": "RadioButtonGroup",
                                "name": "ICSAuthenticationMode",
                                "caption": "Authentication",
                                "value": 1,
                                "options": [
                                    {
                                        "caption": "URL / access key",
                                        "value": 1
                                    },
                                    {
                                        "caption": "Username / password",
                                        "value": 2
                                    }
                                ]
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "ICSUsername",
                                "caption": "Username"
                            },
                            {
                                "type": "PasswordTextBox",
                                "name": "ICSPassword",
                                "caption": "Password"
                            },
                            {
                                "type": "Label",
                                "caption": "Username and password are only used when Username / password is selected."
                            },
                            {
                                "type": "Label",
                                "caption": "For an existing account, leave the URL empty to test the existing iCalendar configuration unchanged."
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardICalendarConfiguration($id, $ICSURL, $ICSCalendarName, $ICSAuthenticationMode, $ICSUsername, $ICSPassword);",
                        "nextPage": "calendars"
                    },
                    {
                        "name": "calendars",
                        "caption": "Choose calendars",
                        "closeCaption": "Set up later",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "Select the calendars that OpenCalendar should prepare for this setup."
                            },
                            {
                                "type": "List",
                                "name": "WizardCalendars",
                                "caption": "Available calendars",
                                "rowCount": 8,
                                "add": false,
                                "delete": false,
                                "changeOrder": false,
                                "loadValuesFromConfiguration": false,
                                "columns": [
                                    {
                                        "caption": "Use",
                                        "name": "selected",
                                        "width": "70px",
                                        "align": "center",
                                        "save": true,
                                        "edit": {
                                            "type": "CheckBox"
                                        }
                                    },
                                    {
                                        "caption": "Calendar",
                                        "name": "name",
                                        "width": "auto"
                                    },
                                    {
                                        "caption": "Access",
                                        "name": "access",
                                        "width": "140px"
                                    },
                                    {
                                        "caption": "Default",
                                        "name": "primary",
                                        "width": "90px",
                                        "align": "center"
                                    },
                                    {
                                        "caption": "Calendar ID",
                                        "name": "calendarId",
                                        "width": "1px",
                                        "visible": false,
                                        "save": true
                                    }
                                ],
                                "values": []
                            },
                            {
                                "type": "Label",
                                "caption": "Select at least one calendar. A primary calendar, or the only available calendar, is preselected automatically."
                            },
                            {
                                "type": "Label",
                                "caption": "If you choose Set up later, a newly created calendar account remains disabled until setup is completed."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardCalendarSelection($id, json_encode($WizardCalendars, JSON_THROW_ON_ERROR));",
                        "onConfirm": "IPS_RequestAction($id, 'WizardSelectCalendars', json_encode($WizardCalendars, JSON_THROW_ON_ERROR));",
                        "onUndo": "IPS_RequestAction($id, 'WizardCalendarSelectionUndo', '');",
                        "nextPage": "summary"
                    },
                    {
                        "name": "summary",
                        "caption": "Calendar account ready",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "The calendar account connection was verified successfully."
                            },
                            {
                                "type": "Label",
                                "caption": "The selected calendars have been saved for the next setup step."
                            },
                            {
                                "type": "Label",
                                "caption": "With OK, OpenCalendar activates a newly created calendar account and completes this setup step. Existing accounts keep their current activation state."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardConfirmation($id);",
                        "onConfirm": "IPS_RequestAction($id, 'WizardFinishAccount', '');"
                    }
                ]
            }
        }
    ]
}
