{
    "actions": [
        {
            "type": "Label",
            "caption": "OpenCalendar can be configured step by step with the setup assistant."
        },
        {
            "type": "PopupButton",
            "name": "SetupWizard",
            "caption": "Start OpenCalendar setup",
            "width": "300px",
            "popup": {
                "caption": "OpenCalendar setup",
                "closeCaption": "Cancel",
                "items": [
                    {
                        "type": "Label",
                        "caption": "This fallback content is not shown while wizard pages are available."
                    }
                ],
                "pages": [
                    {
                        "name": "welcome",
                        "caption": "Welcome to OpenCalendar",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "This assistant will guide you through the initial OpenCalendar setup."
                            },
                            {
                                "type": "Label",
                                "caption": "The assistant can use an existing calendar account or create a new one."
                            }
                        ],
                        "nextPage": "provider"
                    },
                    {
                        "name": "provider",
                        "caption": "Choose calendar provider",
                        "items": [
                            {
                                "type": "RadioButtonGroup",
                                "name": "Provider",
                                "caption": "Calendar provider",
                                "value": "",
                                "options": [
                                    {
                                        "caption": "Please select a provider",
                                        "value": ""
                                    },
                                    {
                                        "caption": "Google Calendar",
                                        "value": "google"
                                    },
                                    {
                                        "caption": "Microsoft 365 / Outlook.com",
                                        "value": "microsoft"
                                    },
                                    {
                                        "caption": "Apple iCloud",
                                        "value": "apple"
                                    },
                                    {
                                        "caption": "CalDAV",
                                        "value": "caldav"
                                    },
                                    {
                                        "caption": "ICS / Webcal",
                                        "value": "ics"
                                    }
                                ]
                            }
                        ],
                        "validate": "return $Provider === '' ? 'Please select a calendar provider.' : '';",
                        "onConfirm": "IPS_RequestAction($id, 'WizardProvider', $Provider);",
                        "onUndo": "IPS_RequestAction($id, 'WizardProviderUndo', '');",
                        "nextPage": "account"
                    },
                    {
                        "name": "account",
                        "caption": "Choose calendar account",
                        "items": [
                            {
                                "type": "RadioButtonGroup",
                                "name": "AccountMode",
                                "caption": "Calendar account",
                                "value": "new",
                                "options": [
                                    {
                                        "caption": "Create a new calendar account",
                                        "value": "new"
                                    },
                                    {
                                        "caption": "Use an existing calendar account",
                                        "value": "existing"
                                    }
                                ]
                            },
                            {
                                "type": "ValidationTextBox",
                                "name": "AccountName",
                                "caption": "Name for the new calendar account",
                                "value": ""
                            },
                            {
                                "type": "Select",
                                "name": "ExistingAccountID",
                                "caption": "Existing calendar account",
                                "value": 0,
                                "options": [
                                    {
                                        "caption": "Please select an existing calendar account.",
                                        "value": 0
                                    }
                                ]
                            },
                            {
                                "type": "Label",
                                "caption": "For a new account, enter a name. For an existing account, select an account that uses the chosen provider."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardAccountSelection($id, $AccountMode, $ExistingAccountID, $AccountName);",
                        "onConfirm": "IPS_RequestAction($id, 'WizardAccountSelection', json_encode(['mode' => $AccountMode, 'existingAccountID' => $ExistingAccountID, 'accountName' => $AccountName], JSON_THROW_ON_ERROR));",
                        "onUndo": "IPS_RequestAction($id, 'WizardAccountSelectionUndo', '');",
                        "nextPage": "summary"
                    },
                    {
                        "name": "summary",
                        "caption": "Calendar account setup",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "With OK, OpenCalendar will create the new calendar account or select the existing account."
                            },
                            {
                                "type": "Label",
                                "caption": "A newly created account remains inactive. Access data or OAuth will be configured in the next setup step."
                            }
                        ],
                        "validate": "return IPSKALDISCOVERY_ValidateWizardConfirmation($id);",
                        "onConfirm": "IPS_RequestAction($id, 'WizardConfirmAccount', '');"
                    }
                ]
            }
        }
    ]
}
